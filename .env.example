PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=shoplite
DB_USER=root
DB_PASSWORD=your_password

JWT_SECRET=your_secret_key
JWT_EXPIRES_IN=1d

# Set to true to print every SQL query Sequelize runs (great for learning)
DB_LOGGING=false

# --- Production / cloud additions ---
DB_SSL=false                              # true for Aiven / cloud MySQL
CLIENT_URL=http://localhost:5173          # frontend URL(s) allowed by CORS, comma separated
